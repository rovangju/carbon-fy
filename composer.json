{
    "name": "rovangju/carbon-fy",
    "description": "Carbon DateTime extension to determine fiscal year (FY)",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Justin Rovang",
            "email": "generate@itnobody.com"
        }
    ],
    "keywords": [
        "fiscal year",
        "FY",
        "carbon",
        "DateTime"
    ],
    "require": {
        "php": "^8.1",
        "nesbot/carbon": "^3.0"
    },

    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },

    "autoload": {
        "psr-4": {
            "CarbonExt\\FiscalYear\\": "src/CarbonExt/FiscalYear/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CarbonExt\\FiscalYear\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
